<?xml version="1.0" encoding="utf-8"?>
<!--
  Explicit consent before a screenshot leaves the device. Shown only when the user
  chose "اسألني في كل مرة"; the default setting never sends anything.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/consentRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scrim"
    android:clickable="true"
    android:focusable="true"
    android:layoutDirection="rtl">

    <LinearLayout
        android:id="@+id/consentCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="20dp"
        android:background="@drawable/bg_draft_panel"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/draft_consent_title"
            android:textColor="@color/on_surface"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/consentBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/draft_consent_body"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/consentSend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/draft_consent_send"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/consentAlways"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/draft_consent_always"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/consentLocal"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/draft_consent_local"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
