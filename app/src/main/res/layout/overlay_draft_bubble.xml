<?xml version="1.0" encoding="utf-8"?>
<!-- Second, smaller bubble: one tap reads the draft screen. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/draftBubbleRoot"
    android:layout_width="44dp"
    android:layout_height="44dp"
    android:background="@drawable/bg_draft_bubble"
    android:contentDescription="@string/draft_bubble_desc"
    android:elevation="8dp"
    android:focusable="true"
    android:padding="10dp">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/draft_bubble_desc"
        android:src="@drawable/ic_draft" />
</FrameLayout>
