<?xml version="1.0" encoding="utf-8"?>
<!--
  Compact draft card. It is deliberately small (300dp) and lives in a
  NOT_TOUCH_MODAL overlay window so the game keeps receiving every touch outside
  the card. Only the header is draggable; the body scrolls if the device has a
  large font scale.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/draftRoot"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_draft_panel"
    android:clickable="true"
    android:elevation="10dp"
    android:focusable="false"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/draftHeader"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/dragHandle"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/draft_drag"
            android:src="@drawable/ic_drag" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:letterSpacing="0.03"
            android:text="@string/draft_title"
            android:textColor="@color/on_surface"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/draftSource"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/muted"
            android:textSize="10sp" />

        <ImageButton
            android:id="@+id/collapseButton"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/draft_collapse"
            android:padding="6dp"
            android:src="@drawable/ic_chevron" />

        <ImageButton
            android:id="@+id/closeButton"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/common_close"
            android:padding="6dp"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/draftBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/draftStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="4dp"
            android:textColor="@color/muted"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/draftResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/draftNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/draft_accent"
            android:textSize="10sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/refreshButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="34dp"
                android:text="@string/draft_refresh"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/editButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="34dp"
                android:text="@string/draft_edit"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/visionButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="34dp"
                android:text="@string/draft_vision_settings"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/draftHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/draft_hint_no_autoclick"
            android:textColor="@color/muted"
            android:textSize="9sp" />
    </LinearLayout>
</LinearLayout>
